# Copy to .env and fill in what you have. Every field is optional — the
# pipeline runs end-to-end in dry-run mode with none of these set.

# --- Higgsfield (video generation) ---
# Get these from https://cloud.higgsfield.ai/api-keys
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Check the model's page on cloud.higgsfield.ai for the exact id + its parameter schema.
HIGGSFIELD_DEFAULT_MODEL=higgsfield/soul/image-to-video

# --- TikTok (Content Posting API / Direct Post) ---
# From your app at https://developers.tiktok.com — requires the video.publish scope,
# granted via OAuth by the TikTok account you want to post as.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
# Leave false until your app has passed TikTok's content-posting audit — TikTok
# forces every unaudited app's posts to private (SELF_ONLY) regardless of this
# setting, so setting it true early does nothing but skip this pipeline's own
# safety default.
TIKTOK_APP_AUDITED=false

# --- Ideation (optional — falls back to templates without it) ---
ANTHROPIC_API_KEY=

# --- Local output ---
CONTENT_ENGINE_OUTPUT_DIR=output
